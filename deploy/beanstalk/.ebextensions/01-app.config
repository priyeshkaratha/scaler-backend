# Settings bundled with every application version.
# Secrets (SPRING_DATASOURCE_*, JWT_SECRET, ADMIN_*) are set once as environment properties
# on the Elastic Beanstalk environment and are never committed.
option_settings:
  aws:elasticbeanstalk:application:environment:
    SERVER_PORT: "5000"
    SPRING_JPA_SHOW_SQL: "false"
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /actuator/health
    MatcherHTTPCode: "200"
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    BatchSizeType: Fixed
    BatchSize: "1"
